{
  "name": "cueglass",
  "version": "0.6.0",
  "description": "Personal Windows interview practice and permitted meeting assistance",
  "author": "Cueglass",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "setup": "install-electron",
    "dev": "npm run build && electron .",
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts --maxWorkers=1",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "package": "npm run build && electron-builder --win dir",
    "smoke": "node scripts/smoke.mjs",
    "installer": "npm run package && node scripts/build-installer.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "electron": "44.5.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.0",
    "playwright": "^1.56.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "8.3.1",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "jose": "^6.1.0"
  },
  "build": {
    "appId": "local.cueglass.desktop",
    "productName": "Cueglass",
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "directories": {
      "output": "release/0.6.0"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    },
    "asar": true,
    "extraResources": [
      {
        "from": "bundled/whisper",
        "to": "bundled/whisper",
        "filter": [
          "*.exe",
          "*.dll",
          "*.bin",
          "LICENSE*.txt",
          "manifest.json"
        ]
      },
      {
        "from": "bundled/native",
        "to": "bundled/native",
        "filter": [
          "CueAudio.exe"
        ]
      }
    ]
  }
}
